# ============================================================================
# RicsWallet — Environment Configuration (.env)
# ============================================================================

PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-strong-random-64-char-secret

# ----------------------------------------------------------------------------
# 1. DATABASE (REQUIRED FOR PRODUCTION / RENDER)
# ----------------------------------------------------------------------------
# On Render (or Neon / Supabase / Railway), attach a PostgreSQL database and set DATABASE_URL.
# When DATABASE_URL is set, RicsWallet automatically migrates and uses PostgreSQL!
# When left blank locally, it falls back to local SQLite (./data/ricswallet.db).
DATABASE_URL=
SQLITE_DB_PATH=./data/ricswallet.db

# ----------------------------------------------------------------------------
# 2. LIVE BLOCKCHAIN RPC & CUSTODY WALLET (REQUIRED FOR REAL TRANSACTIONS!)
# ----------------------------------------------------------------------------
# Set BSC_RPC_URL to a reliable BNB Smart Chain Mainnet RPC endpoint
# (e.g. Alchemy BSC, QuickNode BSC, Ankr BSC, or https://bsc-rpc.publicnode.com)
BSC_RPC_URL=
RPC_POLL_INTERVAL_MS=5000
RPC_LOG_BATCH_BLOCKS=100

# CRITICAL FOR REAL FUNDS:
# Run `npm run generate-xpub` offline on your own computer to generate a 12-word recovery phrase
# (import into Trust Wallet / Ledger) and paste ONLY your Watch-Only xpub (m/44'/60'/0'/0) below!
# NEVER put a private key (xprv) or seed phrase here, and NEVER use the default demo xpub for real funds!
DEPOSIT_WALLET_XPUB=

# ----------------------------------------------------------------------------
# 3. ADMIN ACCOUNT BOOTSTRAP (FOR PRODUCTION)
# ----------------------------------------------------------------------------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_INITIAL_PASSWORD=

# ----------------------------------------------------------------------------
# 4. NETWORK & DEPOSIT POLICY
# ----------------------------------------------------------------------------
BSC_CHAIN_ID=56
BSC_NETWORK_KEY=BSC_BEP20
BSC_NETWORK_NAME="BNB Smart Chain (BEP-20)"
BSC_EXPLORER_URL=https://bscscan.com
USDT_TOKEN_CONTRACT=0x55d398326f99059fF775485246999027B3197955
USDT_DECIMALS=18

MIN_DEPOSIT_USDT=3
REQUIRED_CONFIRMATIONS=15
INVOICE_EXPIRY_MINUTES=60
LATE_DEPOSIT_POLICY=review

# Optional HMAC secret if also connecting a webhook provider (Alchemy Notify / Moralis Streams / QuickNode)
WEBHOOK_HMAC_SECRET=replace-with-random-webhook-hmac-secret
